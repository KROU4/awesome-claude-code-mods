{
  "name": "mod-showroom-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mod Showroom website: a catalog of Claude Code mods shown inside a mock of the client.",
  "scripts": {
    "snapshot": "node scripts/snapshot.mjs",
    "predev": "node scripts/snapshot.mjs",
    "dev": "vite",
    "prebuild": "node scripts/snapshot.mjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/snapshot.mjs && tsc -p tsconfig.json --noEmit",
    "contrast": "node scripts/contrast.mjs",
    "shoot": "node scripts/shoot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "ajv": "8.20.0",
    "motion": "14.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.56.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
