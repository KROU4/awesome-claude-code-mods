      },
      {
        "slot": "tool-row",
        "tool": "Write",
        "input": "Toggle.tsx",
        "row": [{ "text": "Write", "bold": true }, "(Toggle.tsx)", "  ", { "text": "✓", "color": "#39ff88" }],
        "result": [
          ["Wrote 24 lines to Toggle.tsx"]
        ]
      },
