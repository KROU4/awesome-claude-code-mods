    "desktop"
  ],
  "requires": {
    "claudeCode": ">=2.1.287"
  },
  "capabilities": {
    "network": false,
    "processes": true,
    "filesystem": "read",
    "model": false,
    "promptRewrite": true,
    "blocksTools": false
  },
